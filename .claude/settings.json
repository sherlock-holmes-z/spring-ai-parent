{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Bash(npm *)",
      "Bash(git *)",
      "Bash(node *)"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ]
  },
  "autoCompactThreshold": 80,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write(.claude/settings.json)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'settings.json 已修改，请手动更新 settings.md 以保持一致'"
          }
        ]
      }
    ]
  }
}